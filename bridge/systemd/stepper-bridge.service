[Unit]
Description=Stepper Bridge (PC serial-side)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/stepper-music/bridge
Environment=STEPPER_BRIDGE_PORT=8766
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/sg uucp -c "%h/stepper-music/bridge/.venv/bin/python %h/stepper-music/bridge/bridge.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
